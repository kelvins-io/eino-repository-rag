DEEPSEEK_API_KEY=
EMBEDDING_API_KEY=
# RERANK_API_KEY=          # 可选；留空则复用 EMBEDDING_API_KEY
# ASR_API_KEY=             # 可选；留空则复用 EMBEDDING_API_KEY
# ASR_BASE_URL=https://api.siliconflow.cn/v1
# ASR_MODEL=FunAudioLLM/SenseVoiceSmall
# TTS_API_KEY=             # 可选；留空则复用 ASR_API_KEY / EMBEDDING_API_KEY
