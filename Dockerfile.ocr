FROM golang:1.26-alpine AS builder
RUN apk add --no-cache ca-certificates
WORKDIR /src

COPY go.mod go.sum ./
COPY cmd/ocr/ ./cmd/ocr/
COPY internal/ocr/ ./internal/ocr/

RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/ocr ./cmd/ocr

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates tzdata tesseract-ocr tesseract-ocr-chi-sim poppler-utils wget \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --no-create-home appuser
WORKDIR /app

COPY --from=builder /out/ocr /app/ocr

USER appuser
EXPOSE 8080

ENTRYPOINT ["/app/ocr", "-addr", ":8080"]
